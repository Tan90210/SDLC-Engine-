{
  "name": "sdlc-requirements-engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Evidence-based stakeholder interviews and SDLC decision support with OpenRouter",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "test": "node --test test/*.test.js",
    "check": "node --check server.js && node --check public/app.js",
    "corpus:extract": "python scripts/prepare-corpus.py",
    "corpus:index": "node scripts/index-corpus.js"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1"
  }
}
