# Copy to .env, or enter a key in the app Settings (held in server memory only).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
PORT=3000
# Local SQLite database. Keep it out of source control.
DATA_DIR=./data
# Optional full path to Poppler's pdftoppm executable for original-page previews.
# PDFTOPPM_PATH=C:/path/to/pdftoppm.exe
